# Copy to .env. Never commit .env or real recordings.
DATA_DIR=./data
ASR_BACKEND=mlx
ASR_MODEL=mlx-community/whisper-large-v3-turbo
LLM_MODEL=mlx-community/Qwen3-4B-4bit
DIAR_MODEL=pyannote/speaker-diarization-community-1
# Required only to download gated pyannote weights; not needed during inference.
HF_TOKEN=
HF_HUB_DISABLE_TELEMETRY=1
PYANNOTE_METRICS_ENABLED=0
# Alternative for Linux / Windows: LLM_BACKEND=ollama with a local Ollama server.
LLM_BACKEND=mlx
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
